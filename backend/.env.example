# ============================================
# HealthConnect AI - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Neon DB (Serverless PostgreSQL)
NEON_DATABASE_URL=postgresql://username:password@ep-xxxx-xxxx.neon.tech/healthconnect?sslmode=require
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# ============================================
# LLM PROVIDERS
# ============================================
# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.3

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_TEMPERATURE=0.3

# Google Gemini
GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-pro
GOOGLE_MAX_TOKENS=2048
GOOGLE_TEMPERATURE=0.3

# ============================================
# VECTOR DATABASE
# ============================================
# Pinecone
PINECONE_API_KEY=...
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=healthconnect-rag
PINECONE_DIMENSION=1536
PINECONE_METRIC=cosine
PINECONE_CLOUD=aws
PINECONE_REGION=us-west-2

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ============================================
# APPLICATION SETTINGS
# ============================================
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
APP_NAME=HealthConnect AI Assistant
APP_VERSION=1.0.0
API_PREFIX=/api/v1
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# RAG PIPELINE CONFIGURATION
# ============================================
CHUNK_SIZE=512
CHUNK_OVERLAP=77
TOP_K_RETRIEVAL=5
EMBEDDING_MODEL=text-embedding-3-small
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MAX_CONTEXT_LENGTH=4096

# ============================================
# SAFETY CONFIGURATION
# ============================================
SAFETY_THRESHOLD=0.7
EMERGENCY_KEYWORDS=emergency,urgent,severe,critical,unconscious,bleeding,chest pain,difficulty breathing,stroke,heart attack
MEDICAL_KEYWORDS=diagnosis,treatment,prescription,medication,symptom,condition,disease,illness,prognosis,therapy,surgery
MAX_CONVERSATION_TURNS=50
SESSION_TIMEOUT_MINUTES=30

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
RATE_LIMIT_BURST=150

# ============================================
# CORS SETTINGS
# ============================================
CORS_ORIGINS=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=*

# ============================================
# MONITORING
# ============================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000

# ============================================
# EMAIL (SendGrid)
# ============================================
SENDGRID_API_KEY=SG...
EMAIL_FROM_ADDRESS=noreply@healthconnect.com
EMAIL_FROM_NAME=HealthConnect Clinic

# ============================================
# SMS (Twilio)
# ============================================
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+15551234567

# ============================================
# FILE STORAGE (S3)
# ============================================
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
S3_BUCKET_NAME=healthconnect-ai-storage
S3_PREFIX=uploads/

# ============================================
# GOOGLE CALENDAR
# ============================================
GOOGLE_CALENDAR_API_KEY=...
GOOGLE_CALENDAR_CLIENT_ID=...
GOOGLE_CALENDAR_CLIENT_SECRET=...
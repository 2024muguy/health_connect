.ruff_cache/

# Data Files (will be mounted separately)
data/raw/*
data/processed/*
data/models/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/models/.gitkeep

# Logs
logs/
*.log
*.log.*
nohup.out

# Docker
docker-compose.override.yml
.docker/
Dockerfile*
docker-compose*.yml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

